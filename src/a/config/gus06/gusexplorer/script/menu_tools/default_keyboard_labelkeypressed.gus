@code

$m.font='Courier bold 15'._tofont
$m.text=' '
$m.margin=5

$label=m._jlabel

$m.display='keyboard#Keyboard'
$m.content=label
$m.size=[50,70]
$m.resizable=false
$m.visible=true
$m.alwaysontop=true
$m.draggable=true

$diag=m._jdialog1

while diag._is_visible
 *50._waitfor_ms
 *label._settext#1._keyboard_pressedkeys._join_s