@code

$m.font='Courier bold 15'._tofont
$m.text=1._mouse._join_s
$m.margin=5

$label=m._jlabel

$m.display='mouse#Mouse'
$m.content=label
$m.size=[50,70]
$m.resizable=false
$m.visible=true
$m.alwaysontop=true
$m.draggable=true

$diag=m._jdialog1

while diag._is_visible
 *50._waitfor_ms
 *label._settext#1._mouse._join_s